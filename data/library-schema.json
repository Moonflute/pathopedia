{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://moonflute.github.io/pathopedia/data/library-schema.json",
  "title": "Pathopedia reusable card catalog",
  "type": "object",
  "required": [
    "schemaVersion",
    "catalogVersion",
    "sourceDatasetVersion",
    "locale",
    "pathogens",
    "variants",
    "drugs",
    "responses",
    "responseProfiles",
    "sources",
    "interpretation",
    "panels",
    "categories",
    "diseases",
    "diseaseCategories",
    "diseaseRoutes",
    "diseaseEntityTypes",
    "diseaseContent",
    "counts",
    "therapyContexts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "catalogVersion": {
      "type": "string"
    },
    "sourceDatasetVersion": {
      "type": "string"
    },
    "locale": {
      "const": "ko-KR"
    },
    "interpretation": {
      "type": "object",
      "required": [
        "system",
        "version",
        "note"
      ]
    },
    "panels": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "id",
          "name",
          "domain",
          "observationType",
          "drugIds"
        ]
      }
    },
    "categories": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "id",
          "label",
          "ko",
          "number"
        ]
      }
    },
    "pathogens": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/pathogen"
      }
    },
    "variants": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/variant"
      }
    },
    "drugs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/drug"
      }
    },
    "responses": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string",
          "pattern": "^rsp_[0-9a-f]{16}$"
        }
      }
    },
    "responseProfiles": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/response"
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "title"
        ],
        "anyOf": [
          {
            "required": [
              "url"
            ]
          },
          {
            "required": [
              "note"
            ]
          }
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "description": "A titled public URL or a titled local reference with a provenance note."
      }
    },
    "therapyContexts": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/therapyContext"
      }
    },
    "diseases": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/disease"
      }
    },
    "diseaseCategories": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "icon": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "diseaseRoutes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "icon": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "diseaseEntityTypes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "icon": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "diseaseContent": {
      "type": "object"
    },
    "counts": {
      "type": "object",
      "required": [
        "pathogens",
        "variants",
        "drugs",
        "responses",
        "responseProfiles"
      ],
      "properties": {
        "diseases": {
          "type": "integer",
          "minimum": 0
        },
        "pathogens": {
          "type": "integer",
          "minimum": 0
        },
        "variants": {
          "type": "integer",
          "minimum": 0
        },
        "drugs": {
          "type": "integer",
          "minimum": 0
        },
        "responses": {
          "type": "integer",
          "minimum": 0
        },
        "responseProfiles": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    }
  },
  "$defs": {
    "summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 160,
      "description": "An authored one- or two-sentence concept summary in Korean; never a truncated detail field."
    },
    "sourceIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "section": {
      "type": "object",
      "required": [
        "id",
        "title",
        "text",
        "sourceIds"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "sourceIds": {
          "$ref": "#/$defs/sourceIds"
        }
      }
    },
    "back": {
      "type": "object",
      "required": [
        "sections"
      ],
      "properties": {
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          }
        }
      }
    },
    "resistance": {
      "type": "object",
      "required": [
        "code",
        "label"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      }
    },
    "pathogen": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "domain",
        "name",
        "koreanName",
        "classification",
        "summary",
        "back",
        "sourceIds",
        "representativeRecordId"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "const": "pathogen"
        },
        "domain": {
          "enum": [
            "bacteria",
            "fungi",
            "viruses",
            "parasites"
          ]
        },
        "name": {
          "type": "string"
        },
        "koreanName": {
          "type": "string"
        },
        "classification": {
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/summary"
        },
        "back": {
          "$ref": "#/$defs/back"
        },
        "sourceIds": {
          "$ref": "#/$defs/sourceIds"
        },
        "searchAliases": {
          "$ref": "#/$defs/searchAliases"
        },
        "organDiseases": {
          "$ref": "#/$defs/organDiseases"
        },
        "diseaseIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "representativeRecordId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "variant": {
      "type": "object",
      "required": [
        "id",
        "pathogenId",
        "label",
        "summary",
        "back",
        "observationType",
        "sourceIds",
        "panelId",
        "phenotypeId"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "pathogenId": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/summary"
        },
        "back": {
          "$ref": "#/$defs/back"
        },
        "resistance": {
          "$ref": "#/$defs/resistance"
        },
        "observationType": {
          "enum": [
            "susceptibility",
            "regimen"
          ]
        },
        "sourceIds": {
          "$ref": "#/$defs/sourceIds"
        },
        "therapyIds": {
          "$ref": "#/$defs/sourceIds"
        },
        "organDiseases": {
          "$ref": "#/$defs/organDiseases"
        },
        "panelId": {
          "type": "string",
          "minLength": 1
        },
        "phenotypeId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "drug": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name",
        "family",
        "summary",
        "back",
        "sourceIds"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "const": "drug"
        },
        "name": {
          "type": "string"
        },
        "family": {
          "type": "string"
        },
        "summary": {
          "$ref": "#/$defs/summary"
        },
        "back": {
          "$ref": "#/$defs/back"
        },
        "sourceIds": {
          "$ref": "#/$defs/sourceIds"
        },
        "searchAliases": {
          "$ref": "#/$defs/searchAliases"
        },
        "diseaseIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "response": {
      "type": "object",
      "required": [
        "category",
        "basis",
        "note",
        "sourceIds"
      ],
      "properties": {
        "category": {
          "enum": [
            "S",
            "I",
            "R",
            "ACT",
            "ACTIVE",
            "INACTIVE",
            "REGIMEN",
            "OUTSIDE_REGIMEN"
          ]
        },
        "basis": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "sourceIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Preserves the original game observation and its content-derived profile ID, including legacy repeated citations. Card reference lists deduplicate these IDs; every ID must resolve to sources."
        },
        "applicability": {
          "type": "string"
        }
      }
    },
    "therapyContext": {
      "type": "object",
      "required": [
        "id",
        "recordIds",
        "context",
        "drugIds",
        "sourceIds",
        "note"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "recordIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "drugIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "excludedDrugIds": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "sourceIds": {
          "$ref": "#/$defs/sourceIds"
        },
        "note": {
          "type": "string",
          "minLength": 1
        },
        "combination": {
          "type": "boolean"
        },
        "sites": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "community",
              "urinary",
              "lung",
              "abdomen",
              "bloodstream",
              "soft-tissue"
            ]
          },
          "description": "Clinical sites where this explicitly named context is relevant; patient/AST conditions still apply."
        },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "learningDefault": {
          "type": "boolean",
          "description": "Fallback teaching example when the current site does not match; never broadens applicability."
        },
        "preferenceLabel": {
          "type": "string",
          "minLength": 1
        },
        "requiresCompanion": {
          "type": "boolean",
          "description": "Only this pathogen-directed component is listed; the complete clinical regimen requires additional coverage."
        }
      },
      "description": "Clinical-context preference is authored independently of qualitative susceptibility; no metadata means preference is unknown."
    },
    "searchAliases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "organDiseases": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "skin": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 90
          }
        },
        "blood": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 90
          }
        },
        "heart": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 90
          }
        },
        "bone": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 90
          }
        },
        "lungs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 90
          }
        },
        "urinary": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 90
          }
        },
        "abdomen": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 90
          }
        },
        "brain": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 90
          }
        },
        "liver": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 90
          }
        },
        "eye": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 90
          }
        }
      }
    },
    "disease": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name",
        "englishName",
        "category",
        "entityType",
        "summary",
        "searchAliases",
        "anatomicSites",
        "transmission",
        "clinical",
        "etiologies",
        "treatments",
        "relatedDiseaseIds",
        "sourceIds",
        "reviewStatus",
        "authoredAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "kind": {
          "const": "disease"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "englishName": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "entityType": {
          "enum": [
            "syndrome",
            "specific",
            "infection"
          ]
        },
        "summary": {
          "$ref": "#/$defs/summary"
        },
        "searchAliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "anatomicSites": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "skin",
              "blood",
              "heart",
              "bone",
              "lungs",
              "urinary",
              "abdomen",
              "brain",
              "liver",
              "eye"
            ]
          }
        },
        "transmission": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "clinical": {
          "type": "object",
          "required": [
            "presentation",
            "diagnostics",
            "management",
            "redFlags"
          ],
          "properties": {
            "presentation": {
              "type": "string",
              "minLength": 1
            },
            "diagnostics": {
              "type": "string",
              "minLength": 1
            },
            "management": {
              "type": "string",
              "minLength": 1
            },
            "redFlags": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "etiologies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "context"
            ],
            "properties": {
              "pathogenId": {
                "type": "string",
                "minLength": 1
              },
              "cardId": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "domain": {
                "enum": [
                  "bacteria",
                  "fungi",
                  "viruses",
                  "parasites"
                ]
              },
              "context": {
                "type": "string"
              }
            },
            "oneOf": [
              {
                "required": [
                  "pathogenId"
                ]
              },
              {
                "required": [
                  "name",
                  "domain"
                ],
                "not": {
                  "required": [
                    "pathogenId"
                  ]
                }
              }
            ]
          }
        },
        "treatments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "rank",
              "context",
              "mode",
              "components",
              "coverage"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "rank": {
                "enum": [
                  "preferred",
                  "alternative",
                  "conditional"
                ]
              },
              "context": {
                "type": "string",
                "minLength": 1
              },
              "mode": {
                "enum": [
                  "single",
                  "combination",
                  "sequence"
                ]
              },
              "components": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "drugId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "role": {
                      "enum": [
                        "antimicrobial",
                        "adjunct"
                      ]
                    }
                  },
                  "oneOf": [
                    {
                      "required": [
                        "drugId"
                      ]
                    },
                    {
                      "required": [
                        "name"
                      ],
                      "not": {
                        "required": [
                          "drugId"
                        ]
                      }
                    }
                  ]
                }
              },
              "coverage": {
                "enum": [
                  "regimen",
                  "component"
                ],
                "description": "A named regimen or selected components requiring the rest of the clinical management."
              }
            }
          }
        },
        "relatedDiseaseIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "sourceIds": {
          "$ref": "#/$defs/sourceIds"
        },
        "reviewStatus": {
          "const": "educational-source-reviewed"
        },
        "authoredAt": {
          "type": "string",
          "format": "date"
        },
        "localReferenceNotes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "title",
              "path"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "back": {
          "$ref": "#/$defs/back"
        },
        "supportiveCare": {
          "type": "boolean",
          "description": "Explicitly authored supportive or symptomatic care. An empty drug regimen list alone does not imply supportive care; retain the clinical management and its conditions."
        }
      }
    },
    "diseaseTreatment": {
      "type": "object",
      "required": [
        "id",
        "rank",
        "context",
        "mode",
        "components",
        "coverage"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "rank": {
          "enum": [
            "preferred",
            "alternative",
            "conditional"
          ]
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "single",
            "combination",
            "sequence"
          ]
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "drugId": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "enum": [
                  "antimicrobial",
                  "adjunct"
                ]
              }
            },
            "oneOf": [
              {
                "required": [
                  "drugId"
                ]
              },
              {
                "required": [
                  "name"
                ],
                "not": {
                  "required": [
                    "drugId"
                  ]
                }
              }
            ]
          }
        },
        "coverage": {
          "enum": [
            "regimen",
            "component"
          ],
          "description": "A named regimen or selected components requiring the rest of the clinical management."
        }
      }
    },
    "diseaseEtiology": {
      "type": "object",
      "required": [
        "context"
      ],
      "properties": {
