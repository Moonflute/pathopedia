{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pathopedia authored infectious disease content",
  "type": "object",
  "required": [
    "schemaVersion",
    "category",
    "entities"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/disease"
      }
    }
  },
  "$defs": {
    "summary": {
      "type": "string",
      "minLength": 20,
      "maxLength": 160,
      "description": "An authored one- or two-sentence concept summary in Korean; never a truncated detail field."
    },
    "sourceIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "back": {
      "type": "object",
      "required": [
        "sections"
      ],
      "properties": {
        "sections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/section"
          }
        }
      }
    },
    "section": {
      "type": "object",
      "required": [
        "id",
        "title",
        "text",
        "sourceIds"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "sourceIds": {
          "$ref": "#/$defs/sourceIds"
        }
      }
    },
    "disease": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "name",
        "englishName",
        "category",
        "entityType",
        "summary",
        "searchAliases",
        "anatomicSites",
        "transmission",
        "clinical",
        "etiologies",
        "treatments",
        "relatedDiseaseIds",
        "sourceIds",
        "reviewStatus",
        "authoredAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "kind": {
          "const": "disease"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "englishName": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "entityType": {
          "enum": [
            "syndrome",
            "specific",
            "infection"
          ]
        },
        "summary": {
          "$ref": "#/$defs/summary"
        },
        "searchAliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "anatomicSites": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "skin",
              "blood",
              "heart",
              "bone",
              "lungs",
              "urinary",
              "abdomen",
              "brain",
              "liver",
              "eye"
            ]
          }
        },
        "transmission": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "clinical": {
          "type": "object",
          "required": [
            "presentation",
            "diagnostics",
            "management",
            "redFlags"
          ],
          "properties": {
            "presentation": {
              "type": "string",
              "minLength": 1
            },
            "diagnostics": {
              "type": "string",
              "minLength": 1
            },
            "management": {
              "type": "string",
              "minLength": 1
            },
            "redFlags": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "etiologies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "context"
            ],
            "properties": {
              "pathogenId": {
                "type": "string",
                "minLength": 1
              },
              "cardId": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "domain": {
                "enum": [
                  "bacteria",
                  "fungi",
                  "viruses",
                  "parasites"
                ]
              },
              "context": {
                "type": "string"
              }
            },
            "oneOf": [
              {
                "required": [
                  "pathogenId"
                ]
              },
              {
                "required": [
                  "name",
                  "domain"
                ],
                "not": {
                  "required": [
                    "pathogenId"
                  ]
                }
              }
            ]
          }
        },
        "treatments": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "rank",
              "context",
              "mode",
              "components",
              "coverage"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "rank": {
                "enum": [
                  "preferred",
                  "alternative",
                  "conditional"
                ]
              },
              "context": {
                "type": "string",
                "minLength": 1
              },
              "mode": {
                "enum": [
                  "single",
                  "combination",
                  "sequence"
                ]
              },
              "components": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "drugId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "role": {
                      "enum": [
                        "antimicrobial",
                        "adjunct"
                      ]
                    }
                  },
                  "oneOf": [
                    {
                      "required": [
                        "drugId"
                      ]
                    },
                    {
                      "required": [
                        "name"
                      ],
                      "not": {
                        "required": [
                          "drugId"
                        ]
                      }
                    }
                  ]
                }
              },
              "coverage": {
                "enum": [
                  "regimen",
                  "component"
                ],
                "description": "A named regimen or selected components requiring the rest of the clinical management."
              }
            }
          }
        },
        "relatedDiseaseIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "sourceIds": {
          "$ref": "#/$defs/sourceIds"
        },
        "reviewStatus": {
          "const": "educational-source-reviewed"
        },
        "authoredAt": {
          "type": "string",
          "format": "date"
        },
        "localReferenceNotes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "title",
              "path"
            ],
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "back": {
          "$ref": "#/$defs/back"
        }
      }
    }
  }
}
